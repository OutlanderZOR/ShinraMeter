	<ItemGroup>
		<Resource Include="shinra.png" />
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="del $(OutDir)\SQLite.Interop.dll" />
	</Target>
</Project>